{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hub and dictation bar",
  "windows": [
    "main",
    "bar"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        },
        {
          "url": "https://console.groq.com/*"
        }
      ]
    }
  ]
}
